
# ------------------------------------------------------------
# Переменные окружения проекта
# Скопируйте в .env и заполните реальными значениями.
# Секреты не храните в Git.
# ------------------------------------------------------------

# Адрес API бэкенда (FastAPI). Во фронтенде доступно через import.meta.env.VITE_API_URL
VITE_API_URL=/api

# Порт фронтенда (docker-compose)
FRONTEND_PORT=3000

# Порт бэкенда (docker-compose)
BACKEND_PORT=8000
